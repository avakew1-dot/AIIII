<div class="hero-section color-section color-{{ section.settings.color_scheme }} section-padding {% if section.settings.image_position == 'left' %}hero--image-left{% endif %}">
  <div class="page-width">
    <div class="hero {% if section.settings.image_position == 'left' %}hero--image-left{% endif %}">
      <div class="hero__content">
        {%- if section.settings.eyebrow != blank -%}
          <span class="eyebrow">{% render 'icon-doodle-star' %} {{ section.settings.eyebrow }}</span>
        {%- endif -%}
        {%- if section.settings.use_bubble_headline -%}
          <div class="bubble-headline" style="margin-bottom: 0.4em;">
            {%- if section.settings.handwritten_note != blank -%}
              <span class="bubble-headline__note">{{ section.settings.handwritten_note }}</span>
            {%- endif -%}
            <h1 class="font-bubble" style="font-family: var(--font-bubble); text-transform: lowercase; font-size: clamp(2.8rem, 7vw, 5rem); color: rgb(var(--color-accent));">{{ section.settings.heading }}</h1>
          </div>
        {%- else -%}
          <h1>{{ section.settings.heading }}</h1>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="lede">{{ section.settings.subheading }}</p>
        {%- endif -%}
        <div class="hero__actions">
          {%- if section.settings.button_label != blank -%}
            <a href="{{ section.settings.button_url }}" class="btn btn--primary">{{ section.settings.button_label }}</a>
          {%- endif -%}
          {%- if section.settings.button_label_2 != blank -%}
            <a href="{{ section.settings.button_url_2 }}" class="btn btn--outline">{{ section.settings.button_label_2 }}</a>
          {%- endif -%}
        </div>
      </div>

      <div class="hero__media">
        <div class="stamp-frame">
          <div class="{% if section.settings.use_halftone_image %}halftone-image{% endif %}" style="aspect-ratio: 4/5;">
            {%- if section.settings.image -%}
              {{ section.settings.image | image_url: width: 900 | image_tag: loading: 'eager', widths: '400,600,800,900', sizes: '(min-width: 900px) 480px, 90vw', alt: section.settings.image.alt | default: section.settings.heading }}
            {%- else -%}
              <svg viewBox="0 0 480 600" width="100%" style="aspect-ratio: 4/5; background: rgb(var(--color-background-alt));"><text x="50%" y="50%" text-anchor="middle" fill="rgb(var(--color-text-muted))" font-size="16">This month's cover art</text></svg>
            {%- endif -%}
          </div>
          {% render 'stamp-frame' %}
        </div>
        {%- if section.settings.show_sticker_badge -%}
          {% render 'sticker-badge', text: section.settings.sticker_badge_text, position: 'top-right' %}
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Hero",
  "tag": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "scheme-1"
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The monthly ritual" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "A journal in the post, a story worth telling." },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Every month, a blank journal wrapped in original animal cover art, a matching sticker sheet, and a donation to the charity looking after that animal." },
    {
      "type": "header",
      "content": "Scrapbook headline (optional)"
    },
    {
      "type": "checkbox",
      "id": "use_bubble_headline",
      "label": "Use bubble-lettering headline",
      "info": "Renders the heading in the bold rounded scrapbook font instead of the serif, with a small handwritten note above it.",
      "default": false
    },
    {
      "type": "text",
      "id": "handwritten_note",
      "label": "Handwritten note above headline",
      "default": "hi — it's nice you're here."
    },
    {
      "type": "checkbox",
      "id": "use_halftone_image",
      "label": "Use halftone print treatment on image",
      "info": "Gives the cover art a duotone, screen-printed dot texture in the accent colour.",
      "default": false
    },
    { "type": "text", "id": "button_label", "label": "Primary button label", "default": "Start your subscription" },
    { "type": "url", "id": "button_url", "label": "Primary button link" },
    { "type": "text", "id": "button_label_2", "label": "Secondary button label", "default": "Shop the prints" },
    { "type": "url", "id": "button_url_2", "label": "Secondary button link" },
    { "type": "image_picker", "id": "image", "label": "This month's cover art" },
    {
      "type": "checkbox",
      "id": "show_sticker_badge",
      "label": "Show circular sticker badge on image",
      "default": false
    },
    {
      "type": "text",
      "id": "sticker_badge_text",
      "label": "Sticker badge text",
      "default": "Dear Wild"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position (desktop)",
      "default": "right",
      "options": [
        { "value": "right", "label": "Right" },
        { "value": "left", "label": "Left" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero",
      "category": "Text"
    }
  ]
}
{% endschema %}
