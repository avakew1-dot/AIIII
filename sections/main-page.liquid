<div class="color-section color-{{ section.settings.color_scheme }} section-padding grain-texture">
  <div class="page-width">
    <div class="prose" style="max-width: 68ch; margin-inline:auto;">
      <h1 class="text-center">{{ page.title }}</h1>
      <div class="section-divider">
        <span class="section-divider__line">{% render 'icon-doodle-dash' %}</span>
        {% render 'icon-doodle-star' %}
        <span class="section-divider__line">{% render 'icon-doodle-dash' %}</span>
      </div>
      {{ page.content }}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Page",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
