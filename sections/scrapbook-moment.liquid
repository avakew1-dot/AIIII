<div class="color-section color-{{ section.settings.color_scheme }} section-padding--tight">
  <div class="page-width">
    {%- if section.settings.eyebrow != blank -%}
      <span class="eyebrow">{% render 'icon-doodle-star' %} {{ section.settings.eyebrow }}</span>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}

    <div style="display:flex; align-items:center; flex-wrap:wrap; gap:1.5rem; margin: 2rem 0;">
      {%- for block in section.blocks -%}
        {%- if block.type == 'photo' -%}
          <div style="text-align:center;" {{ block.shopify_attributes }}>
            <div class="stamp-frame stamp-frame--flat" style="width: 160px;">
              <div class="{% if block.settings.halftone %}halftone-image{% endif %}" style="width:160px; height:160px; border-radius:50%; overflow:hidden;">
                {%- if block.settings.image -%}
                  {{ block.settings.image | image_url: width: 320 | image_tag: widths: '160,240,320', alt: block.settings.label }}
                {%- else -%}
                  <div style="width:100%; height:100%; background: rgb(var(--color-background-alt));"></div>
                {%- endif -%}
              </div>
            </div>
            {%- if block.settings.label != blank -%}
              <p class="script-accent" style="font-size:1.1rem; margin-top:0.5em;">{{ block.settings.label }}</p>
            {%- endif -%}
          </div>
          {%- unless forloop.last -%}
            <span class="hide-mobile">{% render 'icon-doodle-arrow' %}</span>
          {%- endunless -%}
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- if section.settings.caption != blank -%}
      <p class="lede" style="max-width: 52ch;">{{ section.settings.caption }}</p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Scrapbook moment",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "scheme-1"
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "How it started" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The first cover, and the fortieth" },
    {
      "type": "richtext",
      "id": "caption",
      "label": "Caption",
      "default": "<p>Same kitchen table, same soft pencil, a few dozen animals later. The process hasn't changed much — we just got a little braver with colour.</p>"
    }
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "Photo",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "label", "label": "Label", "default": "Cover no. 1" },
        { "type": "checkbox", "id": "halftone", "label": "Halftone print treatment", "default": true }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Scrapbook moment",
      "blocks": [{ "type": "photo" }, { "type": "photo" }]
    }
  ]
}
{% endschema %}
