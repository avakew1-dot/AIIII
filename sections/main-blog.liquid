<div class="color-section color-{{ section.settings.color_scheme }} section-padding--tight">
  <div class="page-width">
    <h1 class="text-center">{{ blog.title }}</h1>
    <div class="grid grid--3" style="margin-top:2rem;">
      {%- for article in blog.articles -%}
        <a href="{{ article.url }}" class="postcard-card">
          <div class="postcard-card__media deckle-edge">
            {%- if article.image -%}
              {{ article.image | image_url: width: 700 | image_tag: alt: article.title }}
            {%- endif -%}
          </div>
          <p class="postcard-card__title">{{ article.title }}</p>
          <p class="postcard-card__meta"><span>{{ article.published_at | date: '%B %Y' }}</span></p>
        </a>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Blog posts",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-1" }
  ]
}
{% endschema %}
