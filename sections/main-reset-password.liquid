<div class="color-section color-{{ section.settings.color_scheme }} section-padding--tight">
  <div class="page-width" style="max-width:26rem;">
    <h1 class="text-center">Reset your password</h1>
    {%- form 'recover_customer_password' -%}
      {%- if form.errors -%}
        <div class="form-status">{{ form.errors | default_errors }}</div>
      {%- endif -%}
      {%- if form.posted_successfully? -%}
        <div class="form-status form-status--success">If that email exists, a reset link is on its way.</div>
      {%- else -%}
        <div class="field">
          <label for="RecoverEmail">Email</label>
          <input type="email" id="RecoverEmail" name="email" autocomplete="email" required>
        </div>
        <button type="submit" class="btn btn--primary btn--block">Send reset link</button>
      {%- endif -%}
    {%- endform -%}
  </div>
</div>

{% schema %}
{
  "name": "Reset password",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-1" }
  ]
}
{% endschema %}
