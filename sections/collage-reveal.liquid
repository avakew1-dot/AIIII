<div class="color-section color-{{ section.settings.color_scheme }} section-padding">
  <div class="page-width">
    {%- if section.settings.eyebrow != blank -%}
      <span class="eyebrow">{% render 'icon-doodle-star' %} {{ section.settings.eyebrow }}</span>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
    {%- if section.settings.text != blank -%}<p class="lede" style="margin-bottom:2.5rem;">{{ section.settings.text }}</p>{%- endif -%}

    <div class="collage-reveal">
      {%- for block in section.blocks -%}
        <div class="collage-reveal__item" {{ block.shopify_attributes }}>
          <div class="collage-reveal__media">
            {%- if block.settings.image -%}
              {{ block.settings.image | image_url: width: 320 | image_tag: widths: '160,240,320', alt: block.settings.label }}
            {%- else -%}
              <div style="width:100%; height:100%; display:flex; align-items:center; justify-content:center;">{% render 'icon-doodle-bird' %}</div>
            {%- endif -%}
          </div>
          <span class="collage-reveal__label">{% render 'icon-doodle-star' %} {{ block.settings.label }}</span>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Collage reveal",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "scheme-1"
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "In every envelope" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your month's mail includes" },
    { "type": "textarea", "id": "text", "label": "Text" }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "label", "label": "Label", "default": "a blank journal" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Collage reveal",
      "blocks": [
        { "type": "item", "settings": { "label": "a 64-page blank journal" } },
        { "type": "item", "settings": { "label": "a matching sticker sheet" } },
        { "type": "item", "settings": { "label": "a story card about this month's animal" } }
      ]
    }
  ]
}
{% endschema %}
