<footer class="site-footer color-section color-{{ section.settings.color_scheme }}">
  <div class="page-width">
    <div class="site-footer__grid">
      <div class="site-footer__block">
        {%- if settings.logo -%}
          {{ settings.logo | image_url: width: 200 | image_tag: widths: '100,160,200', alt: shop.name, style: 'width:110px;height:auto;margin-bottom:1rem;' }}
        {%- else -%}
          <p class="script-accent" style="font-size:2rem;">{{ shop.name }}</p>
        {%- endif -%}
        {%- if section.settings.blurb != blank -%}
          <p style="max-width:32ch; color: rgb(var(--color-text-muted));">{{ section.settings.blurb }}</p>
        {%- endif -%}
        <div class="site-footer__social">
          {%- if settings.social_instagram != blank -%}
            <a href="{{ settings.social_instagram }}" aria-label="Instagram" target="_blank" rel="noopener">
              <svg width="19" height="19" viewBox="0 0 19 19" fill="none"><rect x="1" y="1" width="17" height="17" rx="4.5" stroke="currentColor" stroke-width="1.3"/><circle cx="9.5" cy="9.5" r="4" stroke="currentColor" stroke-width="1.3"/><circle cx="14.3" cy="4.7" r="1" fill="currentColor"/></svg>
            </a>
          {%- endif -%}
          {%- if settings.social_tiktok != blank -%}
            <a href="{{ settings.social_tiktok }}" aria-label="TikTok" target="_blank" rel="noopener">
              <svg width="19" height="19" viewBox="0 0 19 19" fill="none"><path d="M11 1v11.2a2.6 2.6 0 1 1-2.2-2.57" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/><path d="M11 1c.3 2.4 2 4 4.4 4.3" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>
            </a>
          {%- endif -%}
          {%- if settings.social_pinterest != blank -%}
            <a href="{{ settings.social_pinterest }}" aria-label="Pinterest" target="_blank" rel="noopener">
              <svg width="19" height="19" viewBox="0 0 19 19" fill="none"><circle cx="9.5" cy="9.5" r="8" stroke="currentColor" stroke-width="1.3"/><path d="M7.5 15C8.5 11 8 9 8 8a2 2 0 0 1 4 0c0 1-1 2.5-1 3.7 0 .8.6 1.3 1.4 1.3 1.6 0 2.6-2 2.6-4.3 0-2.2-1.7-4-4.5-4-3 0-4.8 2.1-4.8 4.4 0 1 .4 1.9 1 2.4" stroke="currentColor" stroke-width="1.1" stroke-linecap="round"/></svg>
            </a>
          {%- endif -%}
        </div>
      </div>

      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'link_list' -%}
            <div class="site-footer__block" {{ block.shopify_attributes }}>
              <h3>{{ block.settings.heading }}</h3>
              <ul>
                {%- for link in block.settings.menu.links -%}
                  <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                {%- endfor -%}
              </ul>
            </div>
          {%- when 'newsletter' -%}
            <div class="site-footer__block" {{ block.shopify_attributes }}>
              <h3>{{ block.settings.heading }}</h3>
              <p style="color: rgb(var(--color-text-muted));">{{ block.settings.text }}</p>
              {%- form 'customer', class: 'newsletter-form' -%}
                <input type="hidden" name="contact[tags]" value="newsletter">
                <label class="visually-hidden" for="footer-email-{{ section.id }}">Email address</label>
                <input type="email" name="contact[email]" id="footer-email-{{ section.id }}" placeholder="you@example.com" required>
                <button type="submit" class="btn btn--outline btn--sm">Join</button>
                {%- if form.posted_successfully? -%}
                  <p style="width:100%; font-size:0.85rem; margin-top:0.5em;">Thank you &mdash; you're on the list.</p>
                {%- endif -%}
              {%- endform -%}
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>

    <div class="site-footer__bottom">
      <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.</span>
      <span>{{ section.settings.bottom_note }}</span>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "scheme-6"
    },
    {
      "type": "textarea",
      "id": "blurb",
      "label": "Brand blurb",
      "default": "A little something in the post, once a month — a blank journal, a sticker sheet, and a story worth telling."
    },
    {
      "type": "text",
      "id": "bottom_note",
      "label": "Bottom note",
      "default": "Made slowly, mailed monthly."
    }
  ],
  "blocks": [
    {
      "type": "link_list",
      "name": "Menu column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Explore" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    },
    {
      "type": "newsletter",
      "name": "Newsletter signup",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Stay in the loop" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "New covers, new causes, first look." }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Footer",
      "blocks": [
        { "type": "link_list" },
        { "type": "link_list" },
        { "type": "newsletter" }
      ]
    }
  ]
}
{% endschema %}
