<div class="color-section color-{{ section.settings.color_scheme }} section-padding">
  <div class="page-width">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
      <div class="{% if section.settings.alignment == 'center' %}text-center{% endif %}" style="max-width:60ch; {% if section.settings.alignment == 'center' %}margin-inline:auto;{% endif %} margin-bottom: 2.5rem;">
        {%- if section.settings.eyebrow != blank -%}
          <span class="eyebrow" {% if section.settings.alignment == 'center' %}style="justify-content:center; width:100%;"{% endif %}>{% render 'icon-doodle-star' %} {{ section.settings.eyebrow }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
        {%- if section.settings.text != blank -%}<p class="lede" {% if section.settings.alignment == 'center' %}style="margin-inline:auto;"{% endif %}>{{ section.settings.text }}</p>{%- endif -%}
      </div>
    {%- endif -%}

    <div class="grid grid--{{ section.settings.columns }}">
      {%- for block in section.blocks -%}
        <a href="{{ block.settings.link | default: '#' }}" class="postcard-card {% if section.settings.card_style == 'plain' %}postcard-card--plain{% endif %}" {{ block.shopify_attributes }}>
          <div class="postcard-card__media {% if section.settings.card_style != 'plain' %}deckle-edge{% endif %}">
            {%- if block.settings.image -%}
              {{ block.settings.image | image_url: width: 700 | image_tag: loading: 'lazy', widths: '350,500,700', alt: block.settings.image.alt | default: block.settings.title }}
            {%- else -%}
              <div style="width:100%; height:100%; display:flex; align-items:center; justify-content:center; color: rgb(var(--color-text-muted));">{% render 'icon-doodle-bird' %}</div>
            {%- endif -%}
            {%- if block.settings.badge != blank -%}
              <span class="postcard-card__badge">{{ block.settings.badge }}</span>
            {%- endif -%}
            {%- if block.settings.show_starburst -%}
              <span class="starburst-accent" style="{{ block.settings.starburst_position }}">{% render 'icon-doodle-starburst', width: 40 %}</span>
            {%- endif -%}
          </div>
          {%- if block.settings.title != blank -%}<p class="postcard-card__title {% if section.settings.card_style == 'plain' %}text-center{% endif %}">{{ block.settings.title }}</p>{%- endif -%}
          {%- if block.settings.subtitle != blank -%}<p class="postcard-card__meta {% if section.settings.card_style == 'plain' %}text-center{% endif %}">{{ block.settings.subtitle }}</p>{%- endif -%}
        </a>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Illustration gallery",
  "tag": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "scheme-1"
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The archive" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Past months' cover art" },
    { "type": "textarea", "id": "text", "label": "Text" },
    {
      "type": "select",
      "id": "alignment",
      "label": "Heading alignment",
      "default": "center",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Centered" }
      ]
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Columns (desktop)",
      "default": "4",
      "options": [
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ]
    },
    {
      "type": "select",
      "id": "card_style",
      "label": "Card style",
      "default": "postcard",
      "options": [
        { "value": "postcard", "label": "Postcard (bordered, deckle edge)" },
        { "value": "plain", "label": "Plain (borderless, centered label)" }
      ]
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Illustration",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title", "default": "The Fox, March" },
        { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "Sold out" },
        { "type": "text", "id": "badge", "label": "Badge text", "default": "" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "checkbox", "id": "show_starburst", "label": "Show starburst accent", "default": false },
        {
          "type": "select",
          "id": "starburst_position",
          "label": "Starburst position",
          "default": "top: -14px; left: -14px;",
          "options": [
            { "value": "top: -14px; left: -14px;", "label": "Top left" },
            { "value": "top: -14px; right: -14px;", "label": "Top right" },
            { "value": "bottom: -14px; right: -14px;", "label": "Bottom right" }
          ]
        }
      ]
    }
  ],
  "max_blocks": 16,
  "presets": [
    {
      "name": "Illustration gallery",
      "blocks": [
        { "type": "item" },
        { "type": "item" },
        { "type": "item" },
        { "type": "item" }
      ]
    }
  ]
}
{% endschema %}
