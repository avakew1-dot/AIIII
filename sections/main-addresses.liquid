<div class="color-section color-{{ section.settings.color_scheme }} section-padding--tight">
  <div class="page-width" style="max-width:40rem;">
    <p><a href="{{ routes.account_url }}" style="text-decoration:underline;">&larr; Back to account</a></p>
    <h1>Addresses</h1>
    {%- for address in customer.addresses -%}
      <div class="postcard-card" style="margin-bottom:1rem;">
        <p>{{ address | format_address }}</p>
        {%- form 'customer_address', address -%}
          <button type="submit" name="_method" value="delete" class="btn btn--outline btn--sm" onclick="return confirm('Delete this address?')">Delete</button>
        {%- endform -%}
      </div>
    {%- endfor -%}

    {%- form 'customer_address', customer.new_address -%}
      <h2>Add a new address</h2>
      <div class="field"><label for="AddressFirstName">First name</label><input type="text" id="AddressFirstName" name="address[first_name]"></div>
      <div class="field"><label for="AddressLastName">Last name</label><input type="text" id="AddressLastName" name="address[last_name]"></div>
      <div class="field"><label for="AddressAddress1">Address</label><input type="text" id="AddressAddress1" name="address[address1]"></div>
      <div class="field"><label for="AddressCity">City</label><input type="text" id="AddressCity" name="address[city]"></div>
      <div class="field"><label for="AddressZip">Postcode</label><input type="text" id="AddressZip" name="address[zip]"></div>
      <div class="field">
        <label for="AddressCountry">Country</label>
        <select id="AddressCountry" name="address[country]">{{ country_option_tags }}</select>
      </div>
      <button type="submit" class="btn btn--primary">Save address</button>
    {%- endform -%}
  </div>
</div>

{% schema %}
{
  "name": "Addresses",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-1" }
  ]
}
{% endschema %}
