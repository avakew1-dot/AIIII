<div class="pattern-gingham color-{{ section.settings.gingham_scheme }} section-padding" style="--gingham-color: var(--color-accent);">
  <div class="page-width text-center">
    <div class="postcard-card color-section color-{{ section.settings.color_scheme }} vintage-frame vintage-frame--{{ settings.frame_style }}" style="max-width: 640px; margin-inline:auto; padding: clamp(2rem, 5vw, 3.5rem);">
      {%- unless settings.frame_style == 'simple' -%}{% render 'vintage-frame' %}{%- endunless -%}
      {%- if section.settings.eyebrow != blank -%}
        <span class="eyebrow text-center" style="justify-content:center; width:100%;">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}
        <p class="lede" style="margin-inline:auto;">{{ section.settings.text }}</p>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_url }}" class="btn btn--primary" style="margin-top:0.75rem;">{{ section.settings.button_label }}</a>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Gingham callout",
  "tag": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "gingham_scheme",
      "label": "Gingham wallpaper colour",
      "info": "Sets the checked pattern colour behind the card.",
      "default": "scheme-3"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Card colour scheme",
      "default": "scheme-1"
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "This month's cause" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Every box gives something back" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>10% of every subscription goes straight to that month's charity partner — see exactly where it lands on our Impact page.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "See our impact" },
    { "type": "url", "id": "button_url", "label": "Button link" }
  ],
  "presets": [
    {
      "name": "Gingham callout",
      "category": "Promotional"
    }
  ]
}
{% endschema %}
