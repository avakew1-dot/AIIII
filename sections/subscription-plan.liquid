{%- assign plan_product = section.settings.product -%}
<div class="color-section color-{{ section.settings.color_scheme }} section-padding">
  <div class="page-width">
    <div class="hero">
      <div class="hero__content" style="max-width:none;">
        <span class="eyebrow">{% render 'icon-doodle-star' %} {{ section.settings.eyebrow }}</span>
        <h1>{{ section.settings.heading }}</h1>
        {%- if section.settings.price_line != blank -%}
          <p class="lede" style="font-size:1.4rem; font-weight:700; color: rgb(var(--color-accent));">{{ section.settings.price_line }}</p>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="lede">{{ section.settings.subheading }}</p>
        {%- endif -%}

        <ul style="display:flex; flex-direction:column; gap:1rem; margin: 1.75rem 0;">
          {%- for block in section.blocks -%}
            {%- if block.type == 'feature' -%}
              <li style="display:flex; gap:0.85rem; align-items:flex-start;" {{ block.shopify_attributes }}>
                <span style="flex-shrink:0; margin-top:0.15em;">{% render 'icon-doodle-paw' %}</span>
                <span>
                  <strong style="font-family:var(--font-heading); font-weight:600;">{{ block.settings.heading }}</strong><br>
                  <span style="color: rgb(var(--color-text-muted));">{{ block.settings.text }}</span>
                </span>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>

        {%- if plan_product -%}
          {% render 'buy-box', buy_box_product: plan_product %}
          {%- if plan_product.selling_plan_groups.size == 0 -%}
            <p style="font-size:0.82rem; color: rgb(var(--color-text-muted)); margin-top:0.75rem;">Add a subscription (selling plan) to this product in Shopify Subscriptions to enable recurring billing.</p>
          {%- endif -%}
        {%- else -%}
          <p style="color: rgb(var(--color-text-muted));">Select the subscription product in the theme editor to enable checkout here.</p>
          <a href="{{ section.settings.fallback_url }}" class="btn btn--primary">{{ section.settings.fallback_label }}</a>
        {%- endif -%}
        <p style="font-size:0.8rem; color: rgb(var(--color-text-muted)); margin-top:0.5rem;">Cancel or pause anytime from your account.</p>

        {%- assign has_accordion = false -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'accordion' -%}{%- assign has_accordion = true -%}{%- endif -%}
        {%- endfor -%}
        {%- if has_accordion -%}
          <div style="margin-top:1.75rem;">
            {%- for block in section.blocks -%}
              {%- if block.type == 'accordion' -%}
                <details class="accordion-item" {{ block.shopify_attributes }}>
                  <summary>{{ block.settings.title }}</summary>
                  <div class="accordion-item__content">{{ block.settings.content }}</div>
                </details>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <div class="hero__media">
        <div class="stamp-frame">
          {%- if section.settings.image -%}
            {{ section.settings.image | image_url: width: 900 | image_tag: widths: '400,600,800,900', alt: section.settings.image.alt | default: section.settings.heading }}
          {%- elsif plan_product.featured_image -%}
            {{ plan_product.featured_image | image_url: width: 900 | image_tag: widths: '400,600,800,900', alt: plan_product.title }}
          {%- endif -%}
          {% render 'stamp-frame' %}
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Subscription plan",
  "tag": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "scheme-1"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Subscription product",
      "info": "The product carrying your monthly journal selling plan."
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Dear Wild box" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "One journal, one story, every month." },
    { "type": "text", "id": "price_line", "label": "Price line", "default": "£23/month — cancel anytime" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "A blank journal wrapped in original animal cover art, a matching sticker sheet, and a donation to that month's charity — delivered to your door." },
    { "type": "image_picker", "id": "image", "label": "Image (optional override)" },
    { "type": "text", "id": "fallback_label", "label": "Fallback button label", "default": "Shop all products" },
    { "type": "url", "id": "fallback_url", "label": "Fallback button link" }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "One 64-page blank journal" },
        { "type": "text", "id": "text", "label": "Text", "default": "Thick, unlined paper wrapped in that month's original animal artwork." }
      ]
    },
    {
      "type": "accordion",
      "name": "Accordion item",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "How it works" },
        { "type": "richtext", "id": "content", "label": "Content", "default": "<p>Subscribe by the 20th of the month to get that month's box. Your card is charged when your box ships, not before.</p>" }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [
    {
      "name": "Subscription plan",
      "blocks": [
        { "type": "feature" },
        { "type": "feature" },
        { "type": "feature" },
        { "type": "accordion", "settings": { "title": "How it works" } },
        { "type": "accordion", "settings": { "title": "What you get" } },
        { "type": "accordion", "settings": { "title": "FAQs" } }
      ]
    }
  ]
}
{% endschema %}
