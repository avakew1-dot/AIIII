<div class="color-section color-{{ section.settings.color_scheme }} section-padding--tight">
  <div class="page-width">
    <div class="product-layout">
      <div data-gallery>
        <div class="stamp-frame" data-gallery-main style="width:100%;">
          {%- if product.featured_media -%}
            {{ product.featured_media.preview_image | image_url: width: 1000 | image_tag: loading: 'eager', widths: '400,600,800,1000', alt: product.featured_media.alt | default: product.title, style: 'width:100%;' }}
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag }}
          {%- endif -%}
          {% render 'stamp-frame' %}
        </div>
        {%- if product.media.size > 1 -%}
          <div class="product-gallery__thumbs">
            {%- for media in product.media -%}
              <button type="button" data-gallery-thumb data-full-src="{{ media.preview_image | image_url: width: 1000 }}" class="{% if forloop.first %}is-active{% endif %}">
                {{ media.preview_image | image_url: width: 140 | image_tag: alt: media.alt | default: product.title }}
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <div class="product-info">
        {%- if product.type != blank -%}<span class="eyebrow">{{ product.type }}</span>{%- endif -%}
        <h1>{{ product.title }}</h1>
        <p class="product-info__price">
          {%- if product.compare_at_price > product.price -%}
            <s style="opacity:.6;">{{ product.compare_at_price | money }}</s> {{ product.price | money }}
          {%- else -%}
            {{ product.price | money }}
          {%- endif -%}
        </p>

        {%- if product.description != blank -%}
          <div class="prose" style="margin-bottom:1.5rem;">{{ product.description }}</div>
        {%- endif -%}

        {% render 'buy-box', buy_box_product: product %}

        {%- if section.settings.show_shipping_note -%}
          <div class="section-divider" style="justify-content:flex-start; margin-block:1.5rem;">
            {% render 'icon-doodle-dash' %}
          </div>
          <p style="font-size:0.85rem; color: rgb(var(--color-text-muted));">{{ section.settings.shipping_note }}</p>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Product information",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "scheme-1"
    },
    { "type": "checkbox", "id": "show_shipping_note", "label": "Show shipping note", "default": true },
    { "type": "text", "id": "shipping_note", "label": "Shipping note", "default": "Printed, packed and posted from the UK. Journals ship the first week of each month." }
  ]
}
{% endschema %}
