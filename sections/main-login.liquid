<div class="color-section color-{{ section.settings.color_scheme }} section-padding--tight">
  <div class="page-width" style="max-width:26rem;">
    <h1 class="text-center">Sign in</h1>
    {%- form 'customer_login' -%}
      {%- if form.errors -%}
        <div class="form-status">{{ form.errors | default_errors }}</div>
      {%- endif -%}
      <div class="field">
        <label for="CustomerEmail">Email</label>
        <input type="email" id="CustomerEmail" name="customer[email]" autocomplete="email" required>
      </div>
      {%- if form.password_needed -%}
        <div class="field">
          <label for="CustomerPassword">Password</label>
          <input type="password" id="CustomerPassword" name="customer[password]" autocomplete="current-password" required>
        </div>
      {%- endif -%}
      <button type="submit" class="btn btn--primary btn--block">Sign in</button>
      <p class="text-center" style="margin-top:1rem; font-size:0.85rem;">
        <a href="{{ routes.account_recover_url }}" style="text-decoration:underline;">Forgot your password?</a>
      </p>
    {%- endform -%}
    {%- if shop.customer_accounts_enabled and shop.customer_accounts_optional -%}
      <p class="text-center" style="margin-top:1.5rem; font-size:0.85rem;">
        New here? <a href="{{ routes.account_register_url }}" style="text-decoration:underline;">Create an account</a>
      </p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Customer login",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-1" }
  ]
}
{% endschema %}
